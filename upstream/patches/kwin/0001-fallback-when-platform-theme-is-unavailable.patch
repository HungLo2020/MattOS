 QPlatformTheme *Integration::createPlatformTheme(const QString &name) const
 {
-    return QGenericUnixTheme::createUnixTheme(name);
+    if (QPlatformTheme *theme = QGenericUnixTheme::createUnixTheme(name)) {
+        return theme;
+    }
+
+    // A KDE session can advertise the KDE theme before all optional KDE
+    // theme inputs are available.  Qt assumes this factory never returns a
+    // null theme and dereferences it during QGuiApplication construction.
+    // Keep KWin usable with the generic Qt theme while retaining the KDE
+    // theme whenever it can be created.
+    qCWarning(KWIN_QPA) << "Platform theme is unavailable:" << name << "; using the generic theme";
+    return QGenericUnixTheme::createUnixTheme(QStringLiteral("generic"));
 }
 
