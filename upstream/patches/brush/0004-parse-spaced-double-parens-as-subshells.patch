+#[test]
+fn spaced_double_paren_is_nested_subshells() -> Result<()> {
+    for config in super::parser_configs() {
+        for input in ["( ( echo nested ) )", "( ( a=1 && echo x ) )"] {
+            let program = super::parse_with_config(input, &config)?;
+            let debug = format!("{program:?}");
+            assert!(debug.contains("Subshell"), "{}: {input}: {debug}", config.name);
+            assert!(!debug.contains("Arithmetic"), "{}: {input}: {debug}", config.name);
+        }
+        let program = super::parse_with_config("((1 + 2))", &config)?;
+        assert!(format!("{program:?}").contains("Arithmetic"), "{}", config.name);
+    }
+    Ok(())
+}
