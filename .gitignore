/src/kernel/linux/.config.old
/src/kernel/linux/Module.symvers
/src/kernel/linux/System.map
/src/kernel/linux/vmlinux
/src/kernel/linux/vmlinux.o
/src/kernel/linux/arch/x86/boot/bzImage
/src/kernel/linux/.tmp_versions/
/src/kernel/linux/*.cmd

# Local editor/OS noise
*.swp
*.swo
.DS_Store

# Python helper cache artifacts
__pycache__/
*.pyc
