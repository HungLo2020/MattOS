[Unit]
Description=MattOS Boot Smoke Validation
After=multi-user.target

[Service]
Type=oneshot
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/bin/echo __MATTOS_SMOKE_BEGIN__
ExecStart=/bin/cat /proc/1/comm
ExecStart=/usr/bin/systemctl --version
ExecStart=/bin/test -s /usr/lib/udev/hwdb.bin
ExecStart=/usr/bin/systemd-hwdb query pci:v00008086d0000100Esv00001AF4sd00001100bc02sc00i00
ExecStart=/bin/sh -c '! /usr/bin/systemctl --quiet is-failed systemd-hwdb-update.service'
ExecStart=-/usr/bin/systemctl --no-pager status mattos-shell.service
ExecStart=-/usr/bin/journalctl -b --no-pager -u mattos-shell.service
ExecStart=-/usr/bin/systemctl --no-pager list-dependencies mattos.target
ExecStart=/bin/pwd
ExecStart=/bin/ls /
ExecStart=/bin/echo MattOS
ExecStart=/bin/uname -a
ExecStart=/bin/echo __MATTOS_SMOKE_END__

[Install]
WantedBy=multi-user.target
