[Unit]
Description=MattOS COSMIC compositor session for the graphical installer
After=systemd-udev-trigger.service systemd-udev-settle.service
Wants=systemd-udev-trigger.service systemd-udev-settle.service
Before=mattos-install-graphical.service
ConditionKernelCommandLine=mattos.mode=install-gui

[Service]
Type=notify
NotifyAccess=main
RuntimeDirectory=mattos-installer
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/mattos-installer
Environment=WAYLAND_DISPLAY=wayland-0
# The compositor inherits WAYLAND_DISPLAY so the installer can connect to its
# socket.  Without this explicit selection cosmic-comp's auto-detection treats
# that variable as evidence of an existing compositor and attempts its X11/
# winit backend instead of becoming the DRM/KMS compositor itself.
Environment=COSMIC_BACKEND=kms
# MattOS ships Mesa's GBM backend as part of the source-built runtime closure.
Environment=GBM_BACKENDS_PATH=/usr/lib/x86_64-linux-gnu/gbm
Environment=LIBGL_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri
# A modular DRM driver can finish probing after udevd itself has started.
# Require both coldplug completion and a usable KMS/input device before the
# compositor takes its one-shot backend snapshot.
ExecStartPre=/usr/bin/udevadm settle --timeout=180
ExecStartPre=/bin/sh -c 'for path in /dev/dri/card[0-9]*; do test -c "$path" && exit 0; done; exit 1'
ExecStartPre=/bin/sh -c 'for path in /dev/input/event[0-9]*; do test -c "$path" && exit 0; done; exit 1'
# Mesa's source-built VirGL Gallium path is selected by kmsro for the QEMU
# virtio-gpu DRM device.  Do not force llvmpipe here: COSMIC explicitly owns
# the KMS device and requires exportable scanout buffers.
ExecStart=/usr/bin/cosmic-comp --no-xwayland
StandardOutput=journal+console
StandardError=journal+console
Restart=no
