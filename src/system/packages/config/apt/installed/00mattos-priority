# Explanation: The embedded repository and hosted MattOS repository have equal
# priority. APT therefore selects the newest version while still being able to
# resolve one coherent offline package closure from the installed media
# repository when the hosted repository is stale or unreachable.
Package: *
Pin: release o=MattOS,l=MattOS Local,n=trixie
Pin-Priority: 990

