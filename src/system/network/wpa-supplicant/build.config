# MattOS Linux Wi-Fi: nl80211, WPA2/WPA3, common enterprise EAP, D-Bus.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_CTRL_IFACE_DBUS_NEW=y
CONFIG_CTRL_IFACE_DBUS_INTRO=y
CONFIG_BACKEND=file
CONFIG_TLS=openssl
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y
CONFIG_EAP_OTP=y
CONFIG_EAP_MD5=y
CONFIG_EAP_PWD=y
CONFIG_IEEE80211W=y
CONFIG_IEEE80211R=y
CONFIG_IEEE80211AX=y
CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_SUITEB=y
CONFIG_SUITEB192=y
CONFIG_WPA_CLI_EDIT=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_INTERWORKING=y
CONFIG_HS20=y
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON
