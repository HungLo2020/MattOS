[Unit]
Description=D-Bus System Message Bus
Documentation=man:dbus-broker-launch(1)
DefaultDependencies=no
Requires=dbus.socket
After=dbus.socket systemd-sysusers.service
Before=basic.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=notify-reload
OOMScoreAdjust=-900
LimitNOFILE=16384
ProtectSystem=full
PrivateTmp=true
PrivateDevices=true
ExecStart=/usr/bin/dbus-broker-launch --scope system --config-file=/etc/dbus-1/system.conf

[Install]
Alias=dbus.service
