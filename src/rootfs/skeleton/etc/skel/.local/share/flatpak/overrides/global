[Context]
# COSMIC's native Flatpak Wayland path is not complete yet. Use the shipped
# Xwayland server for applications until that path is validated; users may
# remove this override to opt into native Wayland applications.
sockets=x11;
unset-environment=WAYLAND_DISPLAY;

[Environment]
WAYLAND_DISPLAY=
XDG_SESSION_TYPE=x11
ELECTRON_OZONE_PLATFORM_HINT=x11
