#!/bin/sh
export PATH=/bin:/usr/bin:/sbin:/usr/sbin
export TERM=${TERM:-linux}
if [ "$(id -u 2>/dev/null)" = "0" ]; then
    export PS1='\u@\h:\w# '
else
    export PS1='\u@\h:\w$ '
fi
if [ -d /etc/profile.d ]; then
    for script in /etc/profile.d/*.sh; do
        [ -r "$script" ] && . "$script"
    done
fi
